CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_tplink_mr500-v1-eu=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# LuCI web interface with HTTPS, as in official OpenWrt release images
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
# LTE modem (SIM PIN, APN, network mode) from LuCI: proto ncm for the Fibocom FG621-EA
CONFIG_PACKAGE_luci-proto-ncm=y
